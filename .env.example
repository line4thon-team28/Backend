JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DB_URL=jdbc:postgresql://localhost:5432/pawpose
DB_USERNAME=pawpose
DB_PASSWORD=

# F-03: decoding key, enabled only when explicitly configured
PUBLIC_DATA_SERVICE_KEY=
PUBLIC_DATA_COLLECTION_ENABLED=false
# F-04: use the same private key as embedding-service (32+ random bytes)
MATCHING_WORKER_ENABLED=false
EMBEDDING_URL=http://127.0.0.1:8091/embed
EMBEDDING_API_KEY=
# Exact image hosts only; add the actual team S3 bucket host, comma separated
MATCHING_IMAGE_HOSTS=www.animal.go.kr,openapi.animal.go.kr
