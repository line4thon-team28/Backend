# 서버(EC2)에서 레포 루트에 .env 로 복사해서 값 채우기:  cp deploy/env.server.example .env
# .env 는 .gitignore 에 있어서 커밋되지 않습니다. 절대 깃에 올리지 마세요.

# --- Docker Hub (자동 배포가 받아올 이미지 계정) ---
DOCKERHUB_USERNAME=

# --- 공통 ---
# 32자 이상 무작위 값:  openssl rand -base64 48
JWT_SECRET=

# --- DB (docker-compose의 postgres 컨테이너가 이 값으로 만들어짐) ---
DB_USERNAME=pawpose
# 무작위 값:  openssl rand -hex 24
DB_PASSWORD=

# --- 카카오 (Redirect URI는 FE 주소. 디벨로퍼스 등록값과 완전히 같아야 함) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback

# --- CORS: FE 주소들을 쉼표로 (FE 배포하면 그 주소 추가) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- F-03 공고 수집 (1번) ---
PUBLIC_DATA_SERVICE_KEY=
PUBLIC_DATA_COLLECTION_ENABLED=false

# --- F-04 매칭 (2번). embedding 컨테이너를 켤 때 true ---
MATCHING_WORKER_ENABLED=false
# 32바이트 이상 무작위 값, Spring과 embedding이 같은 값 사용:  openssl rand -hex 32
EMBEDDING_API_KEY=
MATCHING_IMAGE_HOSTS=www.animal.go.kr,openapi.animal.go.kr,pawpose-team28-s3-images.s3.ap-southeast-2.amazonaws.com

# --- S3 (서버는 EC2 역할로 접근하므로 액세스 키 불필요) ---
AWS_REGION=ap-southeast-2
S3_BUCKET=pawpose-team28-s3-images
